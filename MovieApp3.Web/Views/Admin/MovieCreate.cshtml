@model AdminEditMovieViewModel
<h1>Create Movie</h1>
<hr />

@* <form method="post" action="/movies/create"> *@
<form method="post" asp-controller="Admin" asp-action="MovieCreate">
    <div class="row">
        <div class="col-md-8">
            <div class="mb-3"> @*bootstrap 5.'dan sonra form-group yok.*@
                @* <label for="Title">Title</label> *@
                <label asp-for="Title"></label> @* //Title text'ini' yazmaya gerek kalmadı. *@
                @* <input type="text" name="Title" class="form-control"/> *@ @* bu yöntemle yukarı model eklemeye gerek yok   *@
                <input asp-for="Title" class="form-control"  /> @*  //tag helper kullanmak icin viewımporta addHelper ile ekledik *@
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="mb-3">
                @* <label for="Description">Description</label> *@
                <label asp-for="Description"></label>
                @* <textarea type="text" name="Description" class="form-control"></textarea> *@
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

@*          Film oluşturma sayfasında film resmi yüklemeyelim detay sayfasından yükleyelim.   
                <div class="mb-3">
                <label asp-for="ImageUrl"></label>
                <input asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div> *@

            <button type="submit" class="btn btn-primary">Submit</button>
        </div>
        <div class="col-md-4">
            @foreach (var item in (List<Genre>)ViewBag.Genres)
            {
                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           name="genreIds"
                           value="@item.GenreId"
                           id="genre_@(item.GenreId)">
                    <label class="form-check-label" for="genre_@(item.GenreId)">
                        @item.Name
                    </label>
                </div>
            }
        </div>
    </div>
</form>