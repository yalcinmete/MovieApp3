@model AdminEditMovieViewModel
<h1>Edit Movie</h1>
<hr />

@* <form method="post" action="/movies/create"> *@
<form method="post" asp-controller="Admin" asp-action="MovieUpdate">
    <input type="hidden" name="MovieId" value="@Model.MovieId" />
    <div class="form-group">
        @* <label for="Title">Title</label> *@
        <label asp-for="Title"></label> @* //Title text'ini' yazmaya gerek kalmadı. *@
        @* <input type="text" name="Title" class="form-control"/> *@ @* bu yöntemle yukarı model eklemeye gerek yok   *@
        <input asp-for="Title" class="form-control" value="@Model.Title" /> @*  //tag helper kullanmak icin viewımporta addHelper ile ekledik *@
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="form-group">
        @* <label for="Description">Description</label> *@
        <label asp-for="Description"></label>
        @* <textarea type="text" name="Description" class="form-control"></textarea> *@
        <textarea asp-for="Description" class="form-control">@Model.Description</textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-group">
        @* <label for="ImageUrl">ImageUrl</label> *@
        <label asp-for="ImageUrl"></label>
        @* <input type="text" name="ImageUrl" class="form-control" /> *@
        <input asp-for="ImageUrl" class="form-control" value="@Model.ImageUrl" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>
