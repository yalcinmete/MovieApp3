@model AdminEditMovieViewModel
<h1>Edit Movie</h1>
<hr />

@* <form method="post" action="/movies/create"> *@
<form method="post" asp-controller="Admin" asp-action="MovieUpdate">
    <div class="row">
        <div class="col-md-8">
            <div asp-validation-summary="All"></div>
            <input type="hidden" name="MovieId" value="@Model.MovieId" />
            @* <div class="form-group"> Bootstrap 5.0'da form-group yazmaya gerek yok artık.' *@
            <div class="mb-3">
                @* <label for="Title">Title</label> *@
                <label asp-for="Title"></label> @* //Title text'ini' yazmaya gerek kalmadı. *@
                @* <input type="text" name="Title" class="form-control"/> *@ @* bu yöntemle yukarı model eklemeye gerek yok   *@
                <input asp-for="Title" class="form-control" value="@Model.Title" /> @*  //tag helper kullanmak icin viewımporta addHelper ile ekledik *@
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="mb-3">
                @* <label for="Description">Description</label> *@
                <label asp-for="Description"></label>
                @* <textarea type="text" name="Description" class="form-control"></textarea> *@
                <textarea asp-for="Description" class="form-control">@Model.Description</textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            @* <div class="mb-3"> *@
            @* <label for="ImageUrl">ImageUrl</label> *@
            @* <label asp-for="ImageUrl"></label> *@
            @* <input type="text" name="ImageUrl" class="form-control" /> *@
            @* <input asp-for="ImageUrl" class="form-control" value="@Model.ImageUrl" /> *@
            @* <span asp-validation-for="ImageUrl" class="text-danger"></span> *@
            @* </div> *@

            <div class="mb-3">
                <input type="hidden" name="ImageUrl" value="@Model.ImageUrl" />"
                <input type="file" name="file" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">Submit</button>
        </div>
        <div class="col-md-4">
            @foreach (var item in (List<Genre>)ViewBag.Genres)
            {
              <div class="form-check">
                <input class="form-check-input" 
                       type="checkbox"
                       name="genreIds"
                       value="@item.GenreId" 
                       id="genre_@(item.GenreId)" @(Model.SelectedGenres.Any(i=>i.GenreId==item.GenreId)?"checked":"")>
                <label class="form-check-label" for="genre_@(item.GenreId)">
                    @item.Name
                </label>
            </div>
            }
        </div>
    </div>
</form>